# ============================================================================
#  ROYAL WEDDING INVITATION — environment template
#
#  THIS PROJECT NEEDS NO ENVIRONMENT VARIABLES TO BUILD OR RUN.
#
#  The invitation is a static frontend: `npm run build` produces a `dist/`
#  folder that any static host (Vercel included) can serve. There is no API,
#  no database, no mailer and no secret to configure.
#
#  This file is kept only for the optional development ports below. Copy it to
#  `.env` only if you need to change them.
# ============================================================================

# Port for the Vite DEV server (`npm run dev`). Default 5173.
WEB_PORT=5173

# Port for `vite preview` when checking a production build locally. Default 4173.
# PREVIEW_PORT=4173
