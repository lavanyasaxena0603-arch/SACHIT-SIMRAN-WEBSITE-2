# ============================================================================
#  ROYAL RSVP — environment template
#  Copy to `.env` (same folder as package.json) and fill in the values.
#  `.env` is git-ignored. NEVER commit real credentials.
#
#    cp .env.example .env
#    # edit .env
#    npm run build && npm start
# ============================================================================

# ---------------------------------------------------------------- server ----
# Port the API + production site listen on.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Port the Vite DEV server uses (`npm run dev`). Only affects development; in
# production everything is served from PORT above. Change it if 5173 is taken.
WEB_PORT=5173

# Where the SQLite database lives. Relative to the project root.
# Back this file up — it IS the register.
RSVP_DB_PATH=data/rsvp.sqlite

# ----------------------------------------------------------- admin view ----
# REQUIRED in production. The /admin register is unlocked with this password.
# Use a long random string, e.g.  openssl rand -base64 24
ADMIN_PASSWORD=

# Optional but recommended: signing key for the admin session cookie.
# If left blank, ADMIN_PASSWORD is used. Rotating this signs everyone out.
ADMIN_SESSION_SECRET=

# How long an admin session stays valid, in hours.
ADMIN_SESSION_HOURS=12

# -------------------------------------------------- WhatsApp Cloud API ----
# Official Meta WhatsApp Business Cloud API only.
# Get these three from https://business.facebook.com → your app →
#   WhatsApp → API Setup.
#
# 1) WHATSAPP_RECIPIENT_NUMBER  — where notifications go (YOUR phone).
#    Digits only, with country code, no '+' and no spaces.
#    India example: 91XXXXXXXXXX  (your number, no '+')
WHATSAPP_RECIPIENT_NUMBER=

# 2) WHATSAPP_PHONE_NUMBER_ID — the "Phone number ID" of the sending number
#    (NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# 3) WHATSAPP_ACCESS_TOKEN — a permanent System User token with
#    `whatsapp_business_messaging` permission. Temporary tokens expire in 24h.
WHATSAPP_ACCESS_TOKEN=

# 4) Optional. Only needed for template management, not for sending.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Message format ---
# A business may only send FREE-FORM text within 24h of the guest messaging
# first. An RSVP notification is business-INITIATED, so for production you must
# create and get approval for a template, then put its name here.
#
# Template body must be exactly:
#     💌 NEW WEDDING RSVP RECEIVED
#
#     {{1}}
#
# Category: UTILITY.   Language code as registered, e.g. en, en_US.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Leave 1 to allow free-form text when no template is configured (fine for
# testing inside the 24h window). Set 0 to force template-only sending.
WHATSAPP_ALLOW_TEXT=1

# --- Advanced (leave as-is unless you know why) ---
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=12000
WHATSAPP_MAX_ATTEMPTS=8

# ------------------------------------------------------------- limits ----
# Submissions allowed per IP per window, and the window length in ms.
RSVP_RATE_LIMIT=6
RSVP_RATE_WINDOW_MS=600000

# Same guest + same answer inside this window = one row (ms). 2 minutes.
RSVP_DEDUPE_WINDOW_MS=120000

# Salt for hashing visitor IPs before storing them. Change it.
RSVP_IP_HASH_SALT=change-this-to-something-random
