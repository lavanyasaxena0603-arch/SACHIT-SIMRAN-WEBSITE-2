# ---- dependencies ----
node_modules/
.pnp
.pnp.js

# ---- build output ----
dist/
dist-ssr/
*.local

# ---- RSVP backend: the guest register ----
# `data/` holds the live SQLite database and its WAL sidecars. It contains real
# personal data (names, phone numbers, emails) and must NEVER be committed.
# Back it up with `npm run db:backup` instead.
data/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# ---- secrets ----
# `.env.example` IS committed (placeholders only). Everything else is not.
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets.json

# ---- logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server-boot.log
pm2-boot.log
.pm2/

# ---- OS / editor ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- misc ----
*.tar.gz
*.zip
